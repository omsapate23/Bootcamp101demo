{
    "name": "Protocol Bootcamp Desktop",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "vscode",
    "containerEnv": {
        "DISPLAY": ":1"
    },
    "forwardPorts": [
        6080
    ],
    "portsAttributes": {
        "6080": {
            "label": "Open Bootcamp Desktop",
            "onAutoForward": "openBrowser",
            "protocol": "http"
        },
        "5901": {
            "onAutoForward": "ignore"
        }
    },
    "postStartCommand": "bash /usr/local/bin/bootcamp-start",
    "customizations": {
        "codespaces": {
            "portsAttributes": {
                "6080": {
                    "label": "Bootcamp Desktop",
                    "visibility": "private"
                }
            }
        }
    }
}