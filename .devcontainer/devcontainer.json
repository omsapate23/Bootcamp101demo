{
    "name": "Protocol Bootcamp Desktop",
    "image": "ghcr.io/omsapate23/bootcamp-desktop:latest",
    "remoteUser": "vscode",
    "containerEnv": {
        "DISPLAY": ":1"
    },
    "forwardPorts": [
        6080
    ],
    "portsAttributes": {
        "6080": {
            "label": "Bootcamp Desktop",
            "onAutoForward": "openBrowser",
            "protocol": "http"
        }
    },
    "postStartCommand": "bash /usr/local/bin/bootcamp-start",
    "customizations": {
        "codespaces": {
            "portsAttributes": {
                "6080": {
                    "label": "Bootcamp Desktop",
                    "visibility": "private"
                }
            }
        }
    }
}