{
    "name": "Protocol",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/desktop-lite:1": {
            "password": "101"
        }
    },
    "forwardPorts": [
        6080
    ],
    "portsAttributes": {
        "6080": {
            "label": "Desktop GUI",
            "requireLocalPort": true
        }
    },
    "postCreateCommand": "sudo cp -r /workspaces/${localWorkspaceFolderBasename}/ctf_challenges /home/vscode/Desktop/ && sudo chown -R vscode:vscode /home/vscode/Desktop/ctf_challenges"
}